BUILD = ["make", "kernel/kernel", "fs.img"]
QEMU = ["make", "qemu"]
CHECK = "vmcheck"
LOG = "grade.out"

BOOT_TIMEOUT = 60  # seconds for xv6 to reach the shell
TEST_TIMEOUT = 15  # seconds for one test (most take well under 1)


class XV6:
    """xv6 running in qemu on one CPU."""

    def __init__(self, log):
        self.log = log
        # own process group, so that killing it also kills qemu (a child of make)
        self.p = subprocess.Popen(QEMU, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT, start_new_session=True)
        os.set_blocking(self.p.stdout.fileno(), False)
        self.out = b""
        self.booted = self.wait(lambda: b"$ " in self.out, BOOT_TIMEOUT)

    def wait(self, done, timeout):
        end = time.time() + timeout
        while time.time() < end:
            try:
                chunk = os.read(self.p.stdout.fileno(), 65536)
                self.out += chunk
                self.log.write(chunk)
            except BlockingIOError:
                if self.p.poll() is not None:
                    return done()
                time.sleep(0.1)
            if done():
                return True
        return False

    def run(self, cmd, timeout):
        """Run cmd in the shell; return its output and whether it finished."""
        mark = len(self.out)
        self.p.stdin.write((cmd + "\n").encode())
        self.p.stdin.flush()
        ok = self.wait(lambda: self.out.rfind(b"\n$ ") > mark, timeout)
        return self.out[mark:].decode(errors="replace").replace("\r", ""), ok

    def close(self):
        try:
            os.killpg(self.p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        self.p.wait()


def run_tests(names):
    """Run each test in xv6, rebooting after a test that hangs or panics."""
    subprocess.run(BUILD, check=True, stdout=subprocess.DEVNULL)
    out = ""
    vm = None
    with open(LOG, "wb") as log:
        for n in names:
            if vm is None:
                vm = XV6(log)
                if not vm.booted:
                    print(f"xv6 did not reach the shell within {BOOT_TIMEOUT}s (see {LOG})")
                    break
            text, ok = vm.run(f"{CHECK} {n}", TEST_TIMEOUT)
            out += text
            if not ok:
                print(f"{n}: did not finish within {TEST_TIMEOUT}s, restarting xv6")
                vm.close()
                vm = None
        if vm:
            vm.close()
    return out


def main():
    names = sys.argv[1:] or list(EXPECTED)
    for n in names:
        if n not in EXPECTED:
            sys.exit(f"unknown test {n}; tests: {' '.join(EXPECTED)}")
    out = run_tests(names)

    score = total = 0
    for n in names:
        total += POINTS[n]
        m = re.search(rf"^test {re.escape(n)}: (.*?)\n(.*?)^end {re.escape(n)}$", out, re.S | re.M)
        if not m:
            print(f"{n}: FAIL (no output; see grade.out)")
            continue
        what = m.group(1)
        got = [l for l in m.group(2).splitlines() if l.startswith("ev ")]
        want = EXPECTED[n]
        if got == want:
            score += POINTS[n]
            print(f"{n}: OK ({POINTS[n]:g}/{POINTS[n]:g})")
            continue
        i = next((i for i, (a, b) in enumerate(zip(got, want)) if a != b), min(len(got), len(want)))
        print(f"{n}: FAIL (0/{POINTS[n]:g})  -- {what}")
        print(f"    first difference at line {i}:")
        for k in range(max(0, i - 3), i):
            print(f"      {want[k]}")
        print(f"    expected: {want[i] if i < len(want) else '(no more lines)'}")
        print(f"    got:      {got[i] if i < len(got) else '(no more lines)'}")
    print(f"score: {score:g}/{total:g}")


if __name__ == "__main__":
    main()
