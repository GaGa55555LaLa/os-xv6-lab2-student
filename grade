_TIME_INK = (235, 238, 242, 246, 253, 60, 99, 147, 75, 117, 159,
             130, 178, 220, 229, 78, 208, 81)


def _time_scene(t, width=78, height=22):
    """A deterministic frame; the temple never touches the grading state."""
    cells = [[" "] * width for _ in range(height)]
    ink = [[0] * width for _ in range(height)]
    cx, floor = width // 2, height - 5

    def ease(x):
        x = max(0.0, min(1.0, x))
        return x * x * (3 - 2 * x)

    def put(x, y, char, color):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < width and 0 <= y < height:
            cells[y][x], ink[y][x] = char, color

    def text(x, y, value, color):
        for dx, char in enumerate(value):
            put(x + dx, y, char, color)

    def spark(x, y, char, color):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < width and 0 <= y < height and cells[y][x] in (" ", ".", ":"):
            put(x, y, char, color)

    if width < 58 or height < 22:
        floor = height - 3
        if t > 0.3:
            for x in (3, width - 4):
                text(x - 1, 2, "[=]", 2)
                for y in range(3, floor):
                    put(x, y, "|", 1)
            for x in range(2, width - 2):
                put(x, floor, "_", 0)
        for i in range(18):
            x = (i * 17 + math.sin(t + i) * 2) % (width - 2) + 1
            y = 1 + (i * 7 - t * 0.5) % max(1, floor - 1)
            if math.sin(t * 2 + i) > 0.5:
                spark(x, y, ".", 1)

        gather = ease((t - 1.0) / 2.5)
        for i, (tx, ty) in enumerate(((cx, 0), (cx - 2, 2), (cx + 2, 2))):
            sx = cx + (i - 1) * width * 0.3
            sy = floor - 1
            x = int(round(sx + (tx - sx) * gather))
            y = int(round(sy + (ty - sy) * gather))
            if t > 0.5 and gather < 0.99:
                spark(x, y, "*", 15 + i)
            if gather > 0.4:
                text(x - 1, y, "/\\", 13 if gather > 0.99 else 15 + i)
                text(x - 2, y + 1, "/__\\", 13 if gather > 0.99 else 15 + i)

        if 3.4 < t < 7.7:
            radius = 3 + ease((t - 3.4) / 2) * min(13, width // 3)
            for i in range(24):
                a = i * math.tau / 24 + t
                spark(cx + math.cos(a) * radius,
                      floor - 2 + math.sin(a) * 1.5, ".", 12)

        if t > 1.6 and height >= 10:
            if height >= 14:
                sword = ("o", "H", "\\=={+}==/", "|^|", "| |", "\\ /", "V")
            elif height >= 12:
                sword = ("o", "H", "=={+}==", "|:|", "V")
            else:
                sword = ("<+>", "|", "V")
            resting = floor - len(sword) + 1
            raised = max(4, resting - 3)
            top = resting + int(round((raised - resting) * ease((t - 4.8) / 2.2)))
            for row, value in enumerate(sword):
                text(cx - len(value) // 2, top + row, value, 7 if row < 3 else 10)
            text(cx - 3, floor, "[__|__]", 2)

        if t > 7.0:
            title = "THE HERO OF TIME"[:width]
            count = int(len(title) * ease((t - 7.0) / 1.1))
            text(cx - len(title) // 2, height - 2, title[:count], 13)
        if t > 8.0:
            subtitle = "Time flows again."[:width]
            count = int(len(subtitle) * ease((t - 8.0) / 0.7))
            text(cx - len(subtitle) // 2, height - 1, subtitle[:count], 3)
        return cells, ink

    # Stone emerges from the dark; the floor recedes toward the pedestal.
    stone = min(2, int(max(0, t - 0.3) * 1.4))
    if t > 0.3:
        radius = width * 0.29
        for dx in range(-int(radius), int(radius) + 1):
            arch = 3 + 6 * (1 - math.sqrt(max(0, 1 - (dx / radius) ** 2)))
            put(cx + dx, arch, "_" if abs(dx) < radius * 0.35 else ".", stone)
        for x in (5, 12, width - 13, width - 6):
            text(x - 2, 5, "_===_", stone + 1)
            text(x - 2, 6, "[___]", stone + 1)
            for y in range(7, floor + 1):
                text(x - 1, y, "| |", stone)
                if y % 4 == 0:
                    put(x, y, ":", max(0, stone - 1))
            text(x - 2, floor + 1, "[___]", stone + 1)
        for y in range(floor - 2, floor + 3):
            spread = (y - floor + 3) / 5
            for end in (-width, -width // 2, -width // 4,
                        width // 4, width // 2, width):
                put(cx + end * spread, y, "/" if end < 0 else "\\", 1)
            if y in (floor, floor + 2):
                for x in range(2, width - 2):
                    if (x + y) % 3:
                        put(x, y, "_", 0)

    # Sparse dust has different speeds, depths, and periods.
    for i in range(46):
        x = (i * 29 + math.sin(t * 0.45 + i) * 2) % (width - 4) + 2
        y = 2 + (i * 11 - t * (0.22 + i % 4 * 0.09)) % (floor - 2)
        pulse = math.sin(i * 1.7 + t * 2.1)
        if pulse > 0.25 and t > 0.2:
            spark(x, y, "." if pulse < 0.94 else "+", 0 if pulse < 0.8 else 2)

    gather = ease((t - 1.0) / 2.5)
    starts = ((cx - width * 0.29, floor - 5),
              (cx + width * 0.29, floor - 5), (cx, floor - 1))
    targets = ((cx, 1), (cx - 2, 3), (cx + 2, 3))
    if gather > 0.99:
        for y in range(1, 5):
            for x in range(cx - 4, cx + 4):
                put(x, y, " ", 0)
    for i, ((sx, sy), (tx, ty)) in enumerate(zip(starts, targets)):
        if t < 0.6:
            continue
        for tail in range(6, -1, -1):
            p = ease((t - 1.0 - tail * 0.065) / 2.5)
            x = sx + (tx - sx) * p
            y = sy + (ty - sy) * p
            x += math.sin(p * math.pi * 2 + i * 2) * (1 - p) * 3
            if gather < 0.99:
                spark(x, y, "." if tail else "*", 11 if tail else 15 + i)
        x = int(round(sx + (tx - sx) * gather))
        y = int(round(sy + (ty - sy) * gather))
        if gather > 0.3:
            color = 13 + int(math.sin(t * 3) > 0.4) if gather > 0.99 else 15 + i
            text(x - 1, y, "/\\", color)
            text(x - 2, y + 1, "/__\\", color)

    # The old seal turns once, then its light runs down into the stone.
    unlock = ease((t - 3.4) / 1.4)
    if 3.3 < t < 7.7:
        fade = 1 - ease((t - 6.5) / 1.2)
        for i in range(36):
            a = i * math.tau / 36 + t * 0.55
            r = 8 + unlock * 5
            if (i + int(t * 9)) % 4:
                spark(cx + math.cos(a) * r,
                      floor - 7 + math.sin(a) * r * 0.36,
                      "." if i % 3 else ":", 11 if fade > 0.5 else 1)
        for y in range(6, floor):
            if y < 6 + unlock * (floor - 6):
                put(cx, y, "|", 12 if y % 2 else 14)
                if unlock > 0.6:
                    put(cx - 3, y, ":", 11)
                    put(cx + 3, y, ":", 11)

    if 4.0 < t < 7.2:
        for delay in (0, 0.45, 0.9):
            radius = (t - 4.0 - delay) * 13
            if 0 < radius < width * 0.43:
                for i in range(64):
                    a = i * math.tau / 64
                    put(cx + math.cos(a) * radius,
                        floor + math.sin(a) * radius * 0.10,
                        "-" if i % 3 else ".", 12 if delay == 0 else 8)

    if t > 0.5:
        text(cx - 6, floor, " .----+----. ", stone + 1)
        text(cx - 6, floor + 1, " /____|____\\ ", stone + 1)
        text(cx - 6, floor + 2, " |____|____| ", stone)

    # The blade clears the pedestal slowly; one highlight travels its length.
    rise = int(round(3 * ease((t - 4.8) / 2.2)))
    hilt = floor - 6 - rise
    if t > 1.6:
        sword = ("<o>", "|:|", "|:|", "\\=={+}==/",
                 "|^|", "|:|", "| |", "| |", "\\ /", "V")
        for row, value in enumerate(sword):
            y = hilt - 3 + row
            color = (6 if row < 4 else 8) if t > 3.4 else 2
            if t > 4.5:
                color = (7 if row < 4 else 10)
            if row == 0 and t > 3.4:
                color = 13
            text(cx - len(value) // 2, y, value, color)
            if row == 3 and t > 3.4:
                put(cx, y, "+", 14)
            if row in (4, 5, 6, 7) and t > 4.6:
                if row == 4:
                    put(cx, y, "^", 13)
                elif row == 5:
                    put(cx, y, ":", 4)
        if t > 5.0:
            gleam = hilt + 1 + int((t - 5.0) * 3) % 6
            put(cx - 2, gleam, "+", 14)
            put(cx + 2, gleam, "+", 10)

    if t > 6.3:
        for i in range(18):
            age = (t - 6.3 + i * 0.17) % 2.8
            x = cx + math.sin(i * 2.4 + age * 0.4) * (4 + age * 2)
            y = floor - 2 - age * 4
            if y > 5:
                spark(x, y, "." if age > 1.2 else "+", 11 if age > 1.8 else 13)

    title = "T H E   H E R O   O F   T I M E"
    count = int(len(title) * ease((t - 7.0) / 1.1))
    if count:
        text(cx - len(title) // 2, height - 2, title[:count], 13)
    if t > 8.0:
        subtitle = "Time flows again."
        count = int(len(subtitle) * ease((t - 8.0) / 0.7))
        text(cx - len(subtitle) // 2, height - 1, subtitle[:count], 3)
    return cells, ink


def _time_frame(seconds, width=78, height=22):
    if seconds < 5.4:
        scene_time = seconds * 8.8 / 5.4
    else:
        settle = max(0, min(1, seconds - 5.4))
        scene_time = 8.8 + 0.8 * (2 * settle - settle * settle)
    cells, ink = _time_scene(scene_time, width, height)
    fade = max(0, min(1, (seconds - 6.15) / 1.45))
    light = 1 - fade * fade * (3 - 2 * fade)
    if fade:
        closing = [(cells[y][:], ink[y][:]) for y in (height - 2, height - 1)]
        for y in (height - 2, height - 1):
            cells[y] = [" "] * width
        for y in range(height):
            for x in range(width):
                if light < ((x * 37 + y * 17) % 97 + 1) / 98:
                    cells[y][x] = " "
        text_y = round((height - 2) * light + ((height - 2) // 2) * (1 - light))
        for dy, (row, colors) in enumerate(closing):
            occupied = [x for x, char in enumerate(row) if char != " "]
            if occupied:
                left, right = occupied[0], occupied[-1] + 1
                cells[text_y + dy][left:right] = row[left:right]
                ink[text_y + dy][left:right] = colors[left:right]
    return cells, ink, light


def _time_fade(color, light):
    if light >= 1:
        return color
    ramp = (0, 95, 135, 175, 215, 255)
    if color >= 232:
        rgb = (8 + (color - 232) * 10,) * 3
    else:
        code = color - 16
        rgb = (ramp[code // 36], ramp[(code // 6) % 6], ramp[code % 6])
    rgb = tuple(round(8 + (value - 8) * light) for value in rgb)
    cube = [min(range(6), key=lambda i: abs(ramp[i] - value)) for value in rgb]
    grey = max(0, min(23, round((sum(rgb) / 3 - 8) / 10)))
    cube_error = sum((value - ramp[i]) ** 2 for value, i in zip(rgb, cube))
    grey_error = sum((value - (8 + grey * 10)) ** 2 for value in rgb)
    return 232 + grey if grey_error <= cube_error else 16 + cube[0] * 36 + cube[1] * 6 + cube[2]


def awaken(force=False):
    """The pedestal keeps its own time. Also callable without running tests."""
    try:
        size = os.get_terminal_size(sys.stdout.fileno())
    except (AttributeError, OSError, ValueError):
        size = shutil.get_terminal_size((80, 24))
    width, height = min(78, size.columns - 2), min(26, size.lines - 2)
    animated = force or sys.stdout.isatty()
    if not animated or width < 24 or height < 8:
        print("\n          /\\\n         /__\\\n        /\\  /\\\n       /__\\/__\\\n"
              "\nTime flows again.")
        return

    colored = "NO_COLOR" not in os.environ
    styles = [f"\033[38;5;{color}m" for color in _TIME_INK]
    left_margin = max(0, (size.columns - width) // 2)
    viewport_height = size.lines - 2
    top_margin = (viewport_height - height) // 2
    blank_line = "\r\033[0m\033[K\n"

    def draw(seconds):
        cells, ink, light = _time_frame(seconds, width, height)
        fading = [f"\033[38;5;{_time_fade(color, light)}m" for color in _TIME_INK]
        text_y = round((height - 2) * light + ((height - 2) // 2) * (1 - light))
        output = [f"\033[{viewport_height}A", blank_line * top_margin]
        for y, (row, colors) in enumerate(zip(cells, ink)):
            output.append("\r\033[0m\033[K" + " " * left_margin)
            if colored:
                row_styles = styles if text_y <= y <= text_y + 1 else fading
                previous = -1
                for char, color in zip(row, colors):
                    if color != previous:
                        output.append(row_styles[color])
                        previous = color
                    output.append(char)
                output.append("\033[0m")
            else:
                output.append("".join(row))
            output.append("\033[K\n")
        output.append(blank_line * (viewport_height - height - top_margin))
        sys.stdout.write("".join(output))
        sys.stdout.flush()

    sys.stdout.write("\n" * viewport_height + "\033[?25l")
    start = time.monotonic()
    duration = 8.0
    try:
        while (elapsed := time.monotonic() - start) < duration:
            draw(elapsed)
            time.sleep(max(0, 1 / 24 - (time.monotonic() - start - elapsed)))
    except KeyboardInterrupt:
        pass
    finally:
        try:
            draw(duration)
        finally:
            sys.stdout.write("\033[0m\033[?25h")
            sys.stdout.flush()

